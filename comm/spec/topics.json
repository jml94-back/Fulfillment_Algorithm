{
 "root": "wh/v1",
 "roles": {
  "unity": "Unity 시뮬레이션 (Mac mini M4). 장비 물리·센서의 원본. 실제 현장에서는 각 장비 컨트롤러가 이 자리를 맡는다.",
  "scheduler": "적재·출고 알고리즘 (Python, WMS 역할). 작업 생성, 통로(랙) 선택·배분, 랙에 보관·출고 요청, AMR 배정·시간 예약 경로.",
  "rl": "AMR 주행 정책 추론 (RTX 4060 노트북). 미션 경로를 받아 속도 명령을 낸다.",
  "control": "중앙 관제 (NPU, Qwen + LangGraph). 상태 요약, 운영 명령, 주문 투입.",
  "sensor": "온도 센서·카메라 (자리만 예약, 비상 대응은 현재 범위 밖).",
  "monitor": "기록·대시보드 (읽기 전용)."
 },
 "id_patterns": {
  "amr": "^AMR0[1-9]$",
  "lift": "^L[1-3]$",
  "rail": "^R[1-3]$",
  "shuttle": "^R([1-3])-Shuttle_L(0[1-9]|10)$",
  "channel": "^R([1-3])-([WE])(0[1-9]|[12][0-9]|3[0-3])-L(0[1-9]|10)$",
  "slot": "^R([1-3])-([WE])(0[1-9]|[12][0-9]|3[0-3])-L(0[1-9]|10)-(0[1-9]|1[0-4])$",
  "dock": "^(IN|OUT)[1-6]$",
  "buffer": "^R[1-3]-(IN|OUT)$",
  "charger": "^CH[WE][1-3]$",
  "scale": "^SC-IN[1-6]$",
  "drop": "^DP-OUT[1-6]$",
  "stop": "^(SC-IN[1-6]|DP-OUT[1-6]|R[1-3]-(IN|OUT)|CH[WE][1-3]|QC-(IN|OUT)|WAIT[1-4])$",
  "pallet": "^(P\\d{8}|R[1-3]-\\d{6})$",
  "lane": "^R([1-3])-([WE])(0[1-9]|[12][0-9]|3[0-3])-L(0[1-9]|10)$"
 },
