{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "rack.inventory"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "channels": {
     "type": "array",
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^R([1-3])-([WE])(0[1-9]|[12][0-9]|3[0-3])-L(0[1-9]|10)$"
       },
       {
        "type": "string"
       },
       {
        "type": "integer",
        "minimum": 0,
        "maximum": 14
       },
       {
        "type": "integer",
        "minimum": 0,
        "maximum": 14
       }
      ],
      "items": false,
      "minItems": 4,
      "description": "[채널, SKU, 실제 수량, 가상 수량(예약 반영)]"
     }
    },
    "stored": {
     "type": "integer",
     "minimum": 0
    },
    "capacity": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "channels",
    "stored",
    "capacity"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "rack.inventory.schema.json",
 "title": "rack.inventory"
}