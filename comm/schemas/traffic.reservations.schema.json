{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "traffic.reservations"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "horizon": {
     "type": "number"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "amr": {
        "type": "string",
        "pattern": "^AMR0[1-9]$"
       },
       "mission_id": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "node": {
        "type": "string"
       },
       "t_start": {
        "type": "number"
       },
       "t_end": {
        "type": "number"
       }
      },
      "required": [
       "amr",
       "mission_id",
       "node",
       "t_start",
       "t_end"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "horizon",
    "items"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "traffic.reservations.schema.json",
 "title": "traffic.reservations"
}