{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "wms.snapshot"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "lanes": {
     "type": "array",
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^R([1-3])-([WE])-LV(0[1-9]|10)-N(0[1-9]|[12][0-9]|3[0-3])$"
       },
       {
        "type": "string"
       },
       {
        "type": "integer",
        "minimum": 0,
        "maximum": 14
       }
      ],
      "items": false,
      "minItems": 3,
      "description": "[레인 ID, SKU, 팔레트 수]"
     }
    },
    "pallets": {
     "type": "integer",
     "minimum": 0
    },
    "capacity": {
     "type": "integer",
     "minimum": 0
    },
    "held": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "lanes",
    "pallets",
    "capacity",
    "held"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "wms.snapshot.schema.json",
 "title": "wms.snapshot"
}