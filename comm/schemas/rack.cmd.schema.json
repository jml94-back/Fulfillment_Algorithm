{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "rack.cmd"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "cmd_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "job_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "action": {
     "type": "string",
     "enum": [
      "store",
      "retrieve"
     ]
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^(P\\d{8}|R[1-3]-\\d{6})$",
       "description": "store: 입고 버퍼에 놓인 팔레트. retrieve: null (랙이 맨 앞 팔레트를 고른다)"
      },
      {
       "type": "null"
      }
     ]
    },
    "sku": {
     "type": "string"
    },
    "weight_kg": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "cmd_id",
    "job_id",
    "action",
    "pallet",
    "sku",
    "weight_kg"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "rack.cmd.schema.json",
 "title": "rack.cmd"
}