{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "charger.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "occupied_by": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^AMR0[1-9]$"
      },
      {
       "type": "null"
      }
     ]
    },
    "charging": {
     "type": "boolean"
    },
    "power_kw": {
     "type": "number",
     "minimum": 0
    }
   },
   "required": [
    "occupied_by",
    "charging",
    "power_kw"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "charger.state.schema.json",
 "title": "charger.state"
}