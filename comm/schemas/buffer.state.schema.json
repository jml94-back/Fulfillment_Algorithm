{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "buffer.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "slots": {
     "type": "array",
     "items": {
      "anyOf": [
       {
        "type": "string",
        "pattern": "^P\\d{8}$"
       },
       {
        "type": "null"
       }
      ]
     },
     "minItems": 5,
     "maxItems": 5,
     "description": "0번 = 1번 칸(리프트 바로 옆), 4번 = 5번 칸(AMR 접점)"
    },
    "blocked": {
     "type": "boolean"
    }
   },
   "required": [
    "slots",
    "blocked"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "buffer.state.schema.json",
 "title": "buffer.state"
}