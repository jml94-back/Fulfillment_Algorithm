{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "sensor.cam"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "label": {
     "type": "string"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "x": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "y": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "label",
    "confidence",
    "x",
    "y"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "sensor.cam.schema.json",
 "title": "sensor.cam"
}