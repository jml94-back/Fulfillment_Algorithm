{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "shuttle.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "idle",
      "moving",
      "in_lane",
      "transferring",
      "paused",
      "error"
     ]
    },
    "y": {
     "type": "number",
     "description": "모셔틀의 레일 방향 위치(도면 y, m). 리프트 이송점 = 20.4"
    },
    "satellite": {
     "type": "object",
     "properties": {
      "where": {
       "type": "string",
       "enum": [
        "docked",
        "in_lane"
       ]
      },
      "lane": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^R([1-3])-([WE])-LV(0[1-9]|10)-N(0[1-9]|[12][0-9]|3[0-3])$"
        },
        {
         "type": "null"
        }
       ]
      },
      "pos": {
       "anyOf": [
        {
         "type": "number",
         "minimum": 0,
         "maximum": 14
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "where",
      "lane",
      "pos"
     ],
     "additionalProperties": false
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^P\\d{8}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "cmd_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "queue": {
     "type": "integer",
     "minimum": 0
    },
    "battery": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 100
      },
      {
       "type": "null"
      }
     ]
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "mode",
    "y",
    "satellite",
    "pallet",
    "cmd_id",
    "queue",
    "battery",
    "error"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "shuttle.state.schema.json",
 "title": "shuttle.state"
}