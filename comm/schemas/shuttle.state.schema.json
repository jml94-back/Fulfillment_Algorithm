{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "shuttle.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "busy": {
     "type": "boolean"
    },
    "status": {
     "type": "string"
    },
    "level": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10,
     "description": "단 1~10 (Unity ShuttleController.level)"
    },
    "y": {
     "type": "number",
     "description": "모셔틀의 통로 방향 위치(도면 y, m). 리프트와 주고받는 위치 = 리프트 중심 + 2.0"
    },
    "satellite": {
     "type": "object",
     "properties": {
      "where": {
       "type": "string",
       "enum": [
        "docked",
        "in_lane"
       ]
      },
      "channel": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^R([1-3])-([WE])(0[1-9]|[12][0-9]|3[0-3])-L(0[1-9]|10)$"
        },
        {
         "type": "null"
        }
       ]
      },
      "depth_m": {
       "anyOf": [
        {
         "type": "number",
         "minimum": 0,
         "description": "통로 중심에서 들어간 거리"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "where",
      "channel",
      "depth_m"
     ],
     "additionalProperties": false
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^(P\\d{8}|R[1-3]-\\d{6})$"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "busy",
    "status",
    "level",
    "y",
    "satellite",
    "pallet"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "shuttle.state.schema.json",
 "title": "shuttle.state"
}