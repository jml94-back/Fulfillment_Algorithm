{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "ctrl.cmd"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "action": {
     "type": "string",
     "enum": [
      "pause_all",
      "resume_all",
      "set_policy",
      "request_report",
      "release_hold",
      "cancel_job"
     ]
    },
    "args": {
     "type": "object"
    }
   },
   "required": [
    "action",
    "args"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "ctrl.cmd.schema.json",
 "title": "ctrl.cmd"
}