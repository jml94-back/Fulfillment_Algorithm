{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "shuttle.cmd"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "cmd_id": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "job_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "action": {
     "type": "string",
     "enum": [
      "store",
      "retrieve",
      "relocate",
      "cancel"
     ]
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^P\\d{8}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "lane": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^R([1-3])-([WE])-LV(0[1-9]|10)-N(0[1-9]|[12][0-9]|3[0-3])$"
      },
      {
       "type": "null"
      }
     ]
    },
    "pos": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 14,
       "description": "레인 안 위치, 1 = 레일 쪽 입·출구"
      },
      {
       "type": "null"
      }
     ]
    },
    "to_lane": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^R([1-3])-([WE])-LV(0[1-9]|10)-N(0[1-9]|[12][0-9]|3[0-3])$"
      },
      {
       "type": "null"
      }
     ]
    },
    "to_pos": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 14,
       "description": "레인 안 위치, 1 = 레일 쪽 입·출구"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "cmd_id",
    "job_id",
    "action",
    "pallet",
    "lane",
    "pos",
    "to_lane",
    "to_pos"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "shuttle.cmd.schema.json",
 "title": "shuttle.cmd"
}