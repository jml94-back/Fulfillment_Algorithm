{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "rack.evt"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "event": {
     "type": "string",
     "enum": [
      "accepted",
      "rejected",
      "started",
      "done",
      "failed"
     ]
    },
    "cmd_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "job_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "action": {
     "type": "string",
     "enum": [
      "store",
      "retrieve"
     ]
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^(P\\d{8}|R[1-3]-\\d{6})$"
      },
      {
       "type": "null"
      }
     ]
    },
    "sku": {
     "type": "string"
    },
    "channel": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^R([1-3])-([WE])(0[1-9]|[12][0-9]|3[0-3])-L(0[1-9]|10)$",
       "description": "accepted 부터 = 예약한 채널"
      },
      {
       "type": "null"
      }
     ]
    },
    "slot": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 14,
       "description": "done 에만 = 실제로 넣거나 꺼낸 칸 (실행 시점에 결정)"
      },
      {
       "type": "null"
      }
     ]
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "event",
    "cmd_id",
    "job_id",
    "action",
    "pallet",
    "sku",
    "channel",
    "slot",
    "reason"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "rack.evt.schema.json",
 "title": "rack.evt"
}