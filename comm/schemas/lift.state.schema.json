{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "lift.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "status": {
     "type": "string"
    },
    "height": {
     "type": "number",
     "description": "리프트 바닥 높이 (m, 창고 바닥 윗면 기준). 버퍼 0.50, 단 n = 0.40 + 1.45 x (n-1)"
    },
    "level": {
     "anyOf": [
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 10,
       "description": "멈춰 있는 단 (버퍼 높이·이동 중이면 null)"
      },
      {
       "type": "null"
      }
     ]
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^(P\\d{8}|R[1-3]-\\d{6})$"
      },
      {
       "type": "null"
      }
     ]
    },
    "owner": {
     "anyOf": [
      {
       "type": "string",
       "description": "리프트를 점유한 작업 id (liftOwner)"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "status",
    "height",
    "level",
    "pallet",
    "owner"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "lift.state.schema.json",
 "title": "lift.state"
}