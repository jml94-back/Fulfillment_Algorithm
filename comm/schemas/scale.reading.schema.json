{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "scale.reading"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "pallet": {
     "type": "string",
     "pattern": "^P\\d{8}$"
    },
    "sku": {
     "type": "string"
    },
    "weight_kg": {
     "type": "number",
     "minimum": 0
    },
    "declared_kg": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "type": "null"
      }
     ]
    },
    "stable": {
     "type": "boolean"
    }
   },
   "required": [
    "pallet",
    "sku",
    "weight_kg",
    "declared_kg",
    "stable"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "scale.reading.schema.json",
 "title": "scale.reading"
}