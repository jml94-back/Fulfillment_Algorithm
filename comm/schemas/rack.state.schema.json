{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "rack.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "stored": {
     "type": "integer",
     "minimum": 0
    },
    "capacity": {
     "type": "integer",
     "minimum": 0
    },
    "pending": {
     "type": "integer",
     "minimum": 0,
     "description": "대기·진행 중 작업 수 (PendingTasks)"
    },
    "inbound_free": {
     "type": "boolean",
     "description": "입고 버퍼 끝칸(IN5)이 비어 AMR 이 내려놓을 수 있음 (InboundFree)"
    },
    "total_stored": {
     "type": "integer",
     "minimum": 0
    },
    "total_retrieved": {
     "type": "integer",
     "minimum": 0
    },
    "avg_cycle_s": {
     "anyOf": [
      {
       "type": "number",
       "minimum": 0
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "stored",
    "capacity",
    "pending",
    "inbound_free",
    "total_stored",
    "total_retrieved",
    "avg_cycle_s"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "rack.state.schema.json",
 "title": "rack.state"
}