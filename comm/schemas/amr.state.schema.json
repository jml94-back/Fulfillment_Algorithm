{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "v": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8,32}$"
  },
  "ts": {
   "type": "number"
  },
  "t": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "src": {
   "type": "string",
   "minLength": 1
  },
  "type": {
   "const": "amr.state"
  },
  "corr": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "data": {
   "type": "object",
   "properties": {
    "mode": {
     "type": "string",
     "enum": [
      "idle",
      "moving",
      "picking",
      "dropping",
      "charging",
      "waiting",
      "paused",
      "error",
      "offline"
     ]
    },
    "drive_mode": {
     "type": "string",
     "enum": [
      "scripted",
      "rl"
     ]
    },
    "battery": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "pallet": {
     "anyOf": [
      {
       "type": "string",
       "pattern": "^(P\\d{8}|R[1-3]-\\d{6})$"
      },
      {
       "type": "null"
      }
     ]
    },
    "mission_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "step": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "node": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "mode",
    "drive_mode",
    "battery",
    "pallet",
    "mission_id",
    "step",
    "node",
    "error"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "v",
  "id",
  "ts",
  "t",
  "src",
  "type",
  "corr",
  "data"
 ],
 "additionalProperties": false,
 "$id": "amr.state.schema.json",
 "title": "amr.state"
}